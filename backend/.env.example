# ---------------------------------------------------------------------------
# ConnectMeet backend environment variables
# Copy this file to `.env` and replace the placeholders.
# NEVER commit the real `.env` (it is git-ignored).
# ---------------------------------------------------------------------------

# Flask / security
FLASK_ENV=development
# Local development port (the Vite dev server proxies /api here).
# Gunicorn on Render ignores this and binds to $PORT.
PORT=5001
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
# Access tokens stay valid for 12 hours by default
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# Database (MySQL). Local default matches database/init_db.sql
DATABASE_URL=mysql+pymysql://connectmeet:connectmeet_pass@localhost:3306/connectmeet_db
# Render example:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/connectmeet_db?ssl_ca=cert.pem

# Frontend origin allowed by CORS (comma-separated for extras)
FRONTEND_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=

# Agora — get both from https://console.agora.io -> Project -> App ID / App Certificate
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_RTC_TOKEN_TTL=3600
AGORA_RTM_TOKEN_TTL=3600

# Best-effort in-memory rate limiting (no external service required)
RATE_LIMIT_ENABLED=true

# Set to 1 only for quick local setup without running database/init_db.sql
CREATE_TABLES_ON_START=0
