# ---------------------------------------------------------------------------
# ConnectMeet — keep secrets and build output out of version control
# ---------------------------------------------------------------------------

# Environment files (SECRET_KEY, JWT secret, DB password, Agora certificate)
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node / Vite
node_modules/
dist/
.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tooling artifacts
coverage/
htmlcov/
*.coverage

# Local database dumps (never commit real data)
database/*.dump
database/*.sql.gz
