# ---------------------------------------------------------------------------
# ConnectMeet — environment template
#
# Copy this file to `backend/.env` and fill in real values:
#     copy .env.example backend\.env        (Windows)
#     cp .env.example backend/.env          (macOS / Linux)
#
# `backend/.env` is listed in .gitignore. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# ---- Flask ----------------------------------------------------------------
FLASK_ENV=development
# Local dev port. The Vite dev server proxies /api here.
# Render/Gunicorn ignore this and use the platform's $PORT.
PORT=5001

# Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
JWT_SECRET_KEY=replace-me-with-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# ---- MySQL ----------------------------------------------------------------
# Local development (created by `python init_db.py`):
DATABASE_URL=mysql+pymysql://connectmeet:connectmeet_pass@localhost:3306/connectmeet_db
#
# Production — use the connection string supplied by your MySQL host, e.g.:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/connectmeet_db
#
# Tests default to in-memory SQLite; override only if you want a real MySQL test DB:
# TEST_DATABASE_URL=

# ---- CORS -----------------------------------------------------------------
# The origin(s) allowed to call the API. Local Vite dev server:
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins (e.g. your deployed frontend):
EXTRA_CORS_ORIGINS=

# ---- Agora (video + chat) -------------------------------------------------
# Create a FREE project at https://console.agora.io -> Projects -> Add New Project
# Copy "App ID" and the "Primary Certificate".
# The App ID is public by design; the App Certificate must NEVER reach the browser
# (the backend mints tokens from it).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional token lifetimes (seconds). Default 3600.
AGORA_RTC_TOKEN_TTL=3600
AGORA_RTM_TOKEN_TTL=3600

# ---- Optional tuning ------------------------------------------------------
MEETING_CODE_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789
MEETING_CODE_LENGTH=10
