# ---------------------------------------------------------------------------
# ConnectMeet frontend environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit .env / .env.local (they are git-ignored).
# ---------------------------------------------------------------------------

# Base URL of the ConnectMeet Flask API.
# Local development: leave empty to use the Vite dev proxy (/api -> 127.0.0.1:5001)
# Production (Render free web service): https://connectmeet-api.onrender.com
VITE_API_BASE_URL=

# Agora Web App ID (public identifier, safe to expose in the browser).
# From https://console.agora.io -> Project -> App ID
VITE_AGORA_APP_ID=

# Where meeting invite links should point.
# Production example: https://connectmeet.vercel.app
VITE_FRONTEND_URL=
